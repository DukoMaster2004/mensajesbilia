GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Clave opcional para la IA de la Biblia (si falta, usa GEMINI_API_KEY)
GEMINI_BIBLE_API_KEY=

# Base de datos compartida (la clave de servicio solo se usa en el servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Acceso privado del administrador (no usar credenciales personales de Google)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
